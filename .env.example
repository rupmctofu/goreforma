# PostgreSQL local (dev). Para Neon/Supabase/Producción usar su URL remota:
# DATABASE_URL="postgresql://user:password@host:5432/goreforma"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/goreforma"

# Dominio público (canonical, sitemap, Open Graph).
# En producción usar https://goreforma.es; vacío en local usa el fallback de seo/site.ts.
NEXT_PUBLIC_SITE_URL="https://goreforma.es"